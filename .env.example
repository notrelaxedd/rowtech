# Supabase project "rowtech". The publishable key can only INSERT into
# public.beta_signups (RLS + column grants); it cannot read anything back.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Absolute site URL for Open Graph tags. Optional on Vercel, where the
# production domain is picked up automatically.
SITE_URL=

# PostHog product analytics. TODO: no PostHog project exists yet. Create one,
# then set both here and in Vercel. With the key unset, analytics is a no-op:
# posthog-js is never downloaded and no events are sent.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
